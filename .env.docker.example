# ==============================================================================
# SmartATS Docker Compose Environment Configuration Template
# Copy this file to .env before starting containers with `docker compose up -d`
# ==============================================================================

# PostgreSQL Credentials (smartats-db)
POSTGRES_USER=smartats
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=smartats

# Backend Application Configuration (smartats-app)
DATABASE_URL=postgresql://smartats:replace_with_strong_password@smartats-db:5432/smartats
ENVIRONMENT=production
SECRET_KEY=replace_with_secure_32_char_secret_key
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional Initial Recruiter Credentials
DEFAULT_RECRUITER_EMAIL=recruiter@smartats.com
DEFAULT_RECRUITER_PASSWORD=replace_with_strong_password
