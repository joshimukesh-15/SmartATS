# Database Configuration
# Default to SQLite for seamless zero-setup local development, or configure PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartats
DATABASE_URL=sqlite:///./smartats.db

# App Settings
PROJECT_NAME="SmartATS"
API_V1_STR="/api/v1"
SECRET_KEY="smartats-secret-key-change-in-production"
ENVIRONMENT="development"

# Upload and Storage Settings
UPLOAD_DIR="./data/resumes"
MAX_UPLOAD_SIZE_MB=15

# Matching Weights (w_keyword + w_tfidf should equal 1.0)
WEIGHT_KEYWORD=0.60
WEIGHT_TFIDF=0.40

# OCR Configuration
TESSERACT_CMD=""
OCR_MIN_TEXT_LENGTH=60

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
