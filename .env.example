# ==============================================================================
# SmartATS Environment Configuration Template
# Copy to .env and adjust variables for your deployment environment
# ==============================================================================

# Core Application Settings
PROJECT_NAME="SmartATS"
ENVIRONMENT="development" # Set to "production" in live environments
API_V1_STR="/api/v1"

# Security & Authentication
# IMPORTANT: Generate a high-entropy 256-bit secret key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="smartats-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Default Recruiter Credentials (used for initial bootstrap / testing)
DEFAULT_RECRUITER_EMAIL="recruiter@smartats.com"
DEFAULT_RECRUITER_PASSWORD="recruiter123"

# Database Configuration
# Local SQLite default: sqlite:///./smartats.db
# PostgreSQL example: postgresql://smartats:smartatspassword@localhost:5432/smartats
DATABASE_URL="sqlite:///./smartats.db"

# File Upload & Parser Limits
UPLOAD_DIR="./data/resumes"
MAX_UPLOAD_SIZE_MB=15

# OCR / PyMuPDF Settings
# Optional: Path to Tesseract executable (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe on Windows, /usr/bin/tesseract on Linux)
TESSERACT_CMD=""
OCR_MIN_TEXT_LENGTH=60

# CORS Allowed Origins
# Comma-separated or JSON list of origins permitted to interact with the API
# NOTE: Do NOT use '*' when credentials are enabled in production!
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
